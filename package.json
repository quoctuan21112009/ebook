    "jszip": "^3.10.2",
    "lucide-react": "^0.468.0",
    "multer": "^2.5.0",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "vite": "^6.1.0"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.9.12"
